# syntax=docker/dockerfile:1.7
# Development-only ARM64 proof of concept. This is not a security-reviewed image.
FROM --platform=linux/arm64 ubuntu:20.04@sha256:722ea796ac2d57eeb3627c58a582fc1acc58be51faf815e1bce1682ae5c092f7 AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG RUBY_VERSION=2.7.0
ARG RUBY_SHA256=8c99aa93b5e2f1bc8437d1bbbefd27b13e7694025331f77245d0c068ef1f8cbe
ARG ISOLATE_COMMIT=9c84554464d2aa9161a424e70af67f4210a12c45
ARG ISOLATE_SHA256=d551ac7cf1b1f4fd3909153f35dd30ad56719f3d221121c6d2217f0405ed532e

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl libcap-dev libffi-dev libgdbm-dev \
      libncurses5-dev libpq-dev libreadline-dev libseccomp-dev libssl-dev \
      libsystemd-dev libyaml-dev pkg-config zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://cache.ruby-lang.org/pub/ruby/2.7/ruby-${RUBY_VERSION}.tar.gz" -o /tmp/ruby.tar.gz \
    && echo "${RUBY_SHA256}  /tmp/ruby.tar.gz" | sha256sum -c - \
    && mkdir /tmp/ruby && tar -xzf /tmp/ruby.tar.gz -C /tmp/ruby --strip-components=1 \
    && cd /tmp/ruby && ./configure --disable-install-doc --prefix=/usr/local/ruby-${RUBY_VERSION} \
    && make -j"$(nproc)" && make install

COPY patches/isolate/0001-arm64-ubuntu-20.04-quotactl-fd.patch /tmp/isolate-quotactl-fd.patch

RUN curl -fsSL "https://codeload.github.com/ioi/isolate/tar.gz/${ISOLATE_COMMIT}" -o /tmp/isolate.tar.gz \
    && echo "${ISOLATE_SHA256}  /tmp/isolate.tar.gz" | sha256sum -c - \
    && mkdir /tmp/isolate && tar -xzf /tmp/isolate.tar.gz -C /tmp/isolate --strip-components=1 \
    && patch -d /tmp/isolate -p1 < /tmp/isolate-quotactl-fd.patch \
    && make -C /tmp/isolate -j"$(nproc)" isolate isolate-cg-keeper default.cf systemd/isolate.service \
    && make -C /tmp/isolate DESTDIR=/tmp/isolate-root install

FROM --platform=linux/arm64 ubuntu:20.04@sha256:722ea796ac2d57eeb3627c58a582fc1acc58be51faf815e1bce1682ae5c092f7 AS native-toolchains

ARG DEBIAN_FRONTEND=noninteractive
ARG GCC_VERSION=13.2.0
ARG GCC_SHA256=e275e76442a6067341a27f04c5c6b83d8613144004c0413528863dc6b5c743da
ARG PYTHON_VERSION=3.12.7
ARG PYTHON_SHA256=73ac8fe780227bf371add8373c3079f42a0dc62deff8d612cd15a618082ab623

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl libbz2-dev libexpat1-dev libffi-dev \
      libgdbm-dev libgmp-dev liblzma-dev libmpc-dev libmpfr-dev libncurses5-dev \
      libreadline-dev libsqlite3-dev libssl-dev pkg-config tk-dev uuid-dev xz-utils zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz" -o /tmp/gcc.tar.xz \
    && echo "${GCC_SHA256}  /tmp/gcc.tar.xz" | sha256sum -c - \
    && mkdir /tmp/gcc-src /tmp/gcc-build \
    && tar -xJf /tmp/gcc.tar.xz -C /tmp/gcc-src --strip-components=1 \
    && cd /tmp/gcc-build \
    && /tmp/gcc-src/configure --prefix="/usr/local/gcc-${GCC_VERSION}" --disable-bootstrap --disable-multilib --enable-languages=c,c++ \
    && make -j"$(nproc)" \
    && make install-strip

RUN curl -fsSL "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" -o /tmp/python.tgz \
    && echo "${PYTHON_SHA256}  /tmp/python.tgz" | sha256sum -c - \
    && mkdir /tmp/python \
    && tar -xzf /tmp/python.tgz -C /tmp/python --strip-components=1 \
    && cd /tmp/python \
    && ./configure --prefix="/usr/local/python-${PYTHON_VERSION}" --with-ensurepip=no \
    && make -j"$(nproc)" \
    && make install

FROM --platform=linux/arm64 ubuntu:20.04@sha256:722ea796ac2d57eeb3627c58a582fc1acc58be51faf815e1bce1682ae5c092f7 AS runtimes

ARG DEBIAN_FRONTEND=noninteractive
ARG GO_VERSION=1.22.7
ARG GO_SHA256=ed695684438facbd7e0f286c30b7bc2411cfc605516d8127dc25c62fe5b03885
ARG JDK_VERSION=17.0.12_7
ARG JDK_SHA256=8257de06bf37f0c8f19f8d542e2ab5a4e17db3ca5f29d041bd0b02ab265db021
ARG NODE_VERSION=22.8.0
ARG NODE_SHA256=9498fec4ce1ac2178d48dea825c012ca2ab532486824b8ed0dd3a7ffae87db0f
ARG RUST_VERSION=1.81.0
ARG RUST_SHA256=ef4da9c1ecd56bbbb36f42793524cce3062e6a823ae22cb679a945c075c7755b
ARG TYPESCRIPT_VERSION=5.6.3
ARG TYPESCRIPT_SHA256=ef67f8d8ad895858024b7339d3e34bf112cae3c5db1f538c3079038b17ae30fa
ARG NODE_TYPES_VERSION=22.7.4
ARG NODE_TYPES_SHA256=0c03483630b7b9c7585b6619fbc240269f9bf744de0ef214ec6a4368b725763c
ARG UNDICI_TYPES_VERSION=6.19.8
ARG UNDICI_TYPES_SHA256=6c32d9702b945becc00e2035c66c11169bda294d7b70f06b06e0e97eaac0e418

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-arm64.tar.gz" -o /tmp/go.tar.gz \
    && echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum -c - \
    && mkdir -p "/usr/local/go-${GO_VERSION}" \
    && tar -xzf /tmp/go.tar.gz -C "/usr/local/go-${GO_VERSION}" --strip-components=1

RUN curl -fsSL "https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.12%2B7/OpenJDK17U-jdk_aarch64_linux_hotspot_${JDK_VERSION}.tar.gz" -o /tmp/jdk.tar.gz \
    && echo "${JDK_SHA256}  /tmp/jdk.tar.gz" | sha256sum -c - \
    && mkdir -p /usr/local/openjdk17 \
    && tar -xzf /tmp/jdk.tar.gz -C /usr/local/openjdk17 --strip-components=1

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-arm64.tar.xz" -o /tmp/node.tar.xz \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
    && mkdir -p "/usr/local/node-${NODE_VERSION}" \
    && tar -xJf /tmp/node.tar.xz -C "/usr/local/node-${NODE_VERSION}" --strip-components=1

RUN curl -fsSL "https://static.rust-lang.org/dist/rust-${RUST_VERSION}-aarch64-unknown-linux-gnu.tar.gz" -o /tmp/rust.tar.gz \
    && echo "${RUST_SHA256}  /tmp/rust.tar.gz" | sha256sum -c - \
    && mkdir /tmp/rust \
    && tar -xzf /tmp/rust.tar.gz -C /tmp/rust --strip-components=1 \
    && /tmp/rust/install.sh --prefix="/usr/local/rust-${RUST_VERSION}" --disable-ldconfig

RUN curl -fsSL "https://registry.npmjs.org/typescript/-/typescript-${TYPESCRIPT_VERSION}.tgz" -o /tmp/typescript.tgz \
    && echo "${TYPESCRIPT_SHA256}  /tmp/typescript.tgz" | sha256sum -c - \
    && mkdir -p /usr/local/lib/node_modules/typescript \
    && tar -xzf /tmp/typescript.tgz -C /usr/local/lib/node_modules/typescript --strip-components=1

RUN curl -fsSL "https://registry.npmjs.org/@types/node/-/node-${NODE_TYPES_VERSION}.tgz" -o /tmp/node-types.tgz \
    && echo "${NODE_TYPES_SHA256}  /tmp/node-types.tgz" | sha256sum -c - \
    && mkdir -p /usr/local/lib/node_modules/@types/node \
    && tar -xzf /tmp/node-types.tgz -C /usr/local/lib/node_modules/@types/node --strip-components=1 \
    && curl -fsSL "https://registry.npmjs.org/undici-types/-/undici-types-${UNDICI_TYPES_VERSION}.tgz" -o /tmp/undici-types.tgz \
    && echo "${UNDICI_TYPES_SHA256}  /tmp/undici-types.tgz" | sha256sum -c - \
    && mkdir -p /usr/local/lib/node_modules/undici-types \
    && tar -xzf /tmp/undici-types.tgz -C /usr/local/lib/node_modules/undici-types --strip-components=1

FROM --platform=linux/arm64 ubuntu:20.04@sha256:722ea796ac2d57eeb3627c58a582fc1acc58be51faf815e1bce1682ae5c092f7 AS production

ARG DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/ruby-2.7.0/bin:/opt/.gem/bin:${PATH}" \
    GEM_HOME=/opt/.gem \
    JUDGE0_ARM64_POC=true \
    JUDGE0_ENABLED_LANGUAGE_IDS=50,54,60,62,63,71,73,74 \
    JUDGE0_VERSION=1.13.1-arm64-cgv2-poc \
    JUDGE0_UPSTREAM_COMMIT=ffd7a48cc6da86d6ac155ef10dbd67d02736070b \
    JUDGE0_SECURITY_STATUS=development-only-not-security-reviewed

LABEL org.opencontainers.image.source="https://github.com/AnisBoubaker/judge0-arm64" \
      org.opencontainers.image.version="1.13.1-dev.2" \
      org.opencontainers.image.licenses="GPL-3.0" \
      io.judge0.arm64.security-status="development-only-not-security-reviewed"

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cron libbz2-1.0 libcap2 libexpat1 libffi7 libgdbm6 libgmp10 liblzma5 \
      libmpc3 libmpfr6 libncurses5 libpq-dev libreadline8 libseccomp2 libsqlite3-0 libssl1.1 \
      libsystemd0 libyaml-0-2 postgresql-client redis-tools shared-mime-info sudo zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/ruby-2.7.0 /usr/local/ruby-2.7.0
COPY --from=build /tmp/isolate-root/ /
COPY --from=native-toolchains /usr/local/gcc-13.2.0 /usr/local/gcc-13.2.0
COPY --from=native-toolchains /usr/local/python-3.12.7 /usr/local/python-3.12.7
COPY --from=runtimes /usr/local/go-1.22.7 /usr/local/go-1.22.7
COPY --from=runtimes /usr/local/openjdk17 /usr/local/openjdk17
COPY --from=runtimes /usr/local/node-22.8.0 /usr/local/node-22.8.0
COPY --from=runtimes /usr/local/rust-1.81.0 /usr/local/rust-1.81.0
COPY --from=runtimes /usr/local/lib/node_modules/typescript /usr/local/lib/node_modules/typescript
COPY --from=runtimes /usr/local/lib/node_modules/@types /usr/local/lib/node_modules/@types
COPY --from=runtimes /usr/local/lib/node_modules/undici-types /usr/local/lib/node_modules/undici-types

RUN echo "gem: --no-document" > /root/.gemrc \
    && gem install bundler:2.1.4 \
    && ln -sf /usr/local/node-22.8.0/bin/node /usr/local/bin/node \
    && ln -sf /usr/local/lib/node_modules/typescript/bin/tsc /usr/bin/tsc \
    && useradd -u 1000 -m -r judge0 \
    && echo "judge0 ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/judge0

WORKDIR /api
COPY Gemfile Gemfile.lock ./
RUN RAILS_ENV=production bundle install || { \
      find /opt/.gem/extensions -name mkmf.log -type f -exec cat {} \; ; \
      exit 1; \
    }
COPY . .
RUN chown judge0:judge0 /api/tmp

EXPOSE 2358
ENTRYPOINT ["/api/docker-entrypoint.sh"]
CMD ["/api/scripts/server"]
USER judge0
